# Files Git should never upload. Everything here can be re-created
# with the commands in README.md, or is specific to this computer.

# Python environment and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Trained model weights (best_model.pt, ~42 MB) - re-create with: python train.py
checkpoints/

# Evaluation results, previews and the audit log database - re-created by
# calibrate.py, model_card.py and service.py
artifacts/

# Synthetic demo data. The 160 images in demo_data/images/ ARE tracked, via
# Git LFS (see .gitattributes) -- they are synthetic, so safe to publish, and
# LFS keeps clones of the code fast. They regenerate exactly with:
#     python make_demo_data.py --out demo_data --patients 80
# The preprocessed cache is derived data; rebuild it with preprocessing.py.
demo_data/cache_512/

# Image-encryption key (storage.py). NEVER commit: anyone with it can read
# every stored patient image. Back it up somewhere safe instead.
secrets/

# Deployment secrets for docker compose (DR_DATA_KEY). Never commit.
.env

# Real retinal datasets (APTOS, EyePACS, Messidor-2, EyeQ). Their licences
# do not allow redistribution, and this repository is public.
aptos/
eyepacs/
messidor*/
Messidor*/
EyeQ/
eyeq/
*.zip
deepdrid/
idrid/
IDRiD/
