# Written by make_demo_data.py. Points the pipeline at the synthetic
# demo dataset. Delete or edit to switch datasets; a real shell
# environment variable overrides anything here.
DR_CSV=demo_data\labels.csv
DR_IMAGES=demo_data\images
DR_CACHE=demo_data\cache_512
DR_FILENAME_COL=id_code
DR_GRADE_COL=diagnosis
DR_PATIENT_COL=patient_id
DR_PATIENT_SOURCE=column

# Windows DataLoader workers use spawn, not fork: slow and crash-prone.
DR_NUM_WORKERS=0

# Small and short so a CPU-only machine finishes. For checking the
# pipeline runs, not for producing a usable model.
DR_EPOCHS=3
DR_BATCH_SIZE=4
